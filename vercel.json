{
  "framework": "nextjs",
  "regions": [
    "arn1"
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/founder-snapshot",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/autonomous-operations",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/program-adaptation",
      "schedule": "0 8 * * *"
    }
  ]
}
